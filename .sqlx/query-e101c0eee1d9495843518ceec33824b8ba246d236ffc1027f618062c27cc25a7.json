  "db_name": "PostgreSQL",
  "query": "WITH entities AS (SELECT id FROM subscribers WHERE id = $1 AND deleted = FALSE) SELECT i.id AS \"entity_id!: Repo__Id\", e.sequence, e.event, CASE WHEN $2 THEN e.context ELSE NULL::jsonb END as \"context: es_entity::ContextData\", e.recorded_at, p.payload as \"forgettable_payload?\" FROM entities i JOIN subscriber_events e ON i.id = e.id LEFT JOIN subscribers_forgettable_payloads p ON e.id = p.entity_id AND e.sequence = p.sequence ORDER BY i.id, e.sequence",
