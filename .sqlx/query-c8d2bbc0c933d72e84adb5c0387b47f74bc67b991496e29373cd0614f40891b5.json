{
  "db_name": "PostgreSQL",
  "query": "WITH entities AS ((SELECT id FROM account_holders WHERE (id < $2) AND ($2 IS NOT NULL) ORDER BY id DESC LIMIT $1) UNION ALL (SELECT id FROM account_holders WHERE ($2 IS NULL) ORDER BY id DESC LIMIT $1) ORDER BY id DESC LIMIT $1) SELECT i.id AS \"entity_id!: Repo__Id\", e.sequence, e.event, CASE WHEN $3 THEN e.context ELSE NULL::jsonb END as \"context: es_entity::ContextData\", e.recorded_at, p.payload as \"forgettable_payload?\" FROM entities i JOIN account_holder_events e ON i.id = e.id LEFT JOIN account_holders_forgettable_payloads p ON e.id = p.entity_id AND e.sequence = p.sequence ORDER BY i.id desc, i.id, e.sequence",
